# =============================================================================
# DREAD DYN — Premium Card Store Environment Configuration (.env.example)
# Note: Never commit production secret keys or tokens to public repositories.
# =============================================================================

# AI Studio runtime keys (automatically injected when configured)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="YOUR_APP_URL"

# Supabase / PostgreSQL Database Integration (Optional for external DB)
# When provided, replaces the client-side local storage engine.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-admin-key"

# Live Payment Merchant Gateway (Required only for live credit/debit billing)
# When left unset, DREAD DYN uses the verified Demo Gateway and wire transfer invoices.
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PAYPAL_CLIENT_ID="your-paypal-client-id"

# Executive Operations & Concierge Notifications
ADMIN_EMAIL="dreaddyn@gmail.com"
WHATSAPP_SUPPORT_NUMBER="+15553892041"
